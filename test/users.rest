###
### Get User Profile
### @name userGetProfile
GET {{baseAPI}}/user/profile/{{userId}}
Authorization: Bearer {{accessToken}}

###
### Add Favorite Zone
### @name userAddFavorite
PUT {{baseAPI}}/user/me/favorites
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "zonaId": "{{zoneId}}",
  "accion": "add",
  "configuracion_alertas": {
    "aludes": {
      "activo": true,
      "umbral_nivel": 3
    },
    "viento": {
      "activo": true,
      "umbral_kmh": 50
    },
    "reportes_comunidad": {
      "activo": true,
      "tipos_suscritos": ["Avalancha", "Alud"]
    }
  },
  "metodo_notificacion": "PUSH"
}

###
### Remove Favorite Zone
### @name userRemoveFavorite
PUT {{baseAPI}}/user/me/favorites
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "zonaId": "{{zoneId}}",
  "accion": "remove"
}

###
### Update Alert Configuration
### @name userUpdateAlerts
PUT {{baseAPI}}/user/alerts/{{userId}}/{{zoneId}}
Content-Type: application/json

{
  "configuracion_alertas": {
    "aludes": {
      "activo": true,
      "umbral_nivel": 4
    },
    "viento": {
      "activo": false
    },
    "reportes_comunidad": {
      "activo": true,
      "tipos_suscritos": ["Hielo", "Nieve mojada"]
    }
  }
}

###
### Get My Profile (Authenticated)
### @name userGetMyProfile
GET {{baseAPI}}/user/me
Authorization: Bearer {{accessToken}}

###
### Get My Favorites (Authenticated)
### @name userGetMyFavorites
GET {{baseAPI}}/user/me/favorites
Authorization: Bearer {{accessToken}}

###
### Delete User Account (Authenticated)
### @name userDeleteAccount
DELETE {{baseAPI}}/user/delete
Authorization: Bearer {{accessToken}}

###
### Update User Profile
### @name userUpdateProfile
PUT {{baseAPI}}/user/update
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nombre": "Nuevo Nombre",
  "email": "newemail@example.com",
  "avatar_url": "https://example.com/nuevo-avatar.jpg",
  "biografia": "Amante de las montañas y la meteorología",
  "ubicacion": "Barcelona, España"
}

###
### Update User Password
### @name userUpdatePassword
PUT {{baseAPI}}/user/updatepassword
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "Password123#01",
  "newPassword": "newPassword456"
}
